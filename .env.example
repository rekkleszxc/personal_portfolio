# MySQL lead database (use one of the two options below)
DATABASE_URL=mysql://user:password@localhost:3306/portfolio

# ...or separate connection values
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=user
MYSQL_PASSWORD=password
MYSQL_DATABASE=portfolio

# Salt used to hash visitor IPs before storage
IP_HASH_SALT=change-me

# Basic auth for /admin and /api/admin
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Contact form email delivery (optional)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
